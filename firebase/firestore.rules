rules_version = '2';
// Each signed-in person can read and write only their own record under users/{uid}.
// The morning-push job uses a service account, which bypasses these rules.
service cloud.firestore {
  match /databases/{database}/documents {
    // The push public key. Anyone may read it, nobody may write it from a browser.
    match /public/{doc} {
      allow read: if true;
    }
    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
